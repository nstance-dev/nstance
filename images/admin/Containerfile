# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /workspace

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the admin CLI
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT_HASH=unknown
ARG BUILD_DATE=unknown

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -a -trimpath \
    -ldflags="-w -s \
    -X github.com/nstance-dev/nstance/internal/buildvars.buildVersion=${VERSION} \
    -X github.com/nstance-dev/nstance/internal/buildvars.buildDate=${BUILD_DATE} \
    -X github.com/nstance-dev/nstance/internal/buildvars.commitHash=${COMMIT_HASH}" \
    -o /nstance-admin \
    ./cmd/nstance-admin

# Runtime stage
FROM gcr.io/distroless/static:nonroot

WORKDIR /

# Copy the binary from builder
COPY --from=builder /nstance-admin /nstance-admin

# Use distroless nonroot user
USER nonroot:nonroot

ENTRYPOINT ["/nstance-admin"]
