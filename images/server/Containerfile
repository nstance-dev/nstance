# Build against Debian 12's glibc baseline for compatibility with newer Debian releases.
FROM golang:1.26.2-bookworm AS builder

WORKDIR /workspace

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the server (requires CGO for SQLite)
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
ARG COMMIT_HASH=unknown
ARG BUILD_DATE=unknown

RUN GOMEMLIMIT=768MiB CGO_ENABLED=1 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -p=1 -trimpath \
    -ldflags="-w -s \
    -X github.com/nstance-dev/nstance/internal/buildvars.buildVersion=${VERSION} \
    -X github.com/nstance-dev/nstance/internal/buildvars.buildDate=${BUILD_DATE} \
    -X github.com/nstance-dev/nstance/internal/buildvars.commitHash=${COMMIT_HASH}" \
    -o /nstance-server \
    ./cmd/nstance-server

# Runtime stage
FROM gcr.io/distroless/base-debian12:nonroot

WORKDIR /

# Copy the binary from builder
COPY --from=builder /nstance-server /nstance-server

# Use distroless nonroot user
USER nonroot:nonroot

ENTRYPOINT ["/nstance-server"]
