#!/bin/bash
# Copyright 2026 Nadrama Pty Ltd
# SPDX-License-Identifier: Apache-2.0

echo "Running pre-commit checks..."

# Run shellcheck on staged shell scripts
if command -v shellcheck &> /dev/null; then
    echo "Running shellcheck..."
    STAGED_SH_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.sh$')
    if [ -n "$STAGED_SH_FILES" ]; then
        echo "$STAGED_SH_FILES" | xargs shellcheck
        if [ $? -ne 0 ]; then
            echo "Shellcheck failed. Please fix the issues before committing."
            exit 1
        fi
    fi
else
    echo "Warning: shellcheck not installed, skipping shell script linting"
    echo "Install with: brew install shellcheck"
fi

make lint
if [ $? -ne 0 ]; then
    echo "Linting failed. Please fix the issues before committing."
    exit 1
fi

echo "All checks passed!"
exit 0
